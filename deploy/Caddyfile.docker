# Caddyfile for docker-compose deployment.
# Reverse-proxies to the `thalos` container on the shared `web` network.
# Auto-HTTPS via Let's Encrypt (requires DNS A/AAAA → server, ports 80/443 open).

thalos.at, www.thalos.at {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@static {
		path /_next/static/*
		path /images/*
		path /icon.svg
		path /logo.svg
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Optional: gate /admin/ behind HTTP Basic Auth.
	# Sveltia itself requires a GitHub PAT, but basic-auth keeps random bots out
	# of the login page. Generate hash via: `docker run --rm caddy:2 caddy hash-password`
	# Then uncomment the block and replace the hash.
	#
	# @admin path /admin/* /admin
	# basicauth @admin {
	# 	editor JDJhJDE0JFJFUExBQ0VfTUVfV0lUSF9CQ1JZUFRfSEFTSA
	# }

	reverse_proxy thalos:3000
}
