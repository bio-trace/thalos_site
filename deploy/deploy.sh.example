#!/usr/bin/env bash
# Copy to deploy/deploy.sh, fill in SERVER + SSH_USER, then `bash deploy/deploy.sh`.
# Assumes:
#   - server has Node 20, www-thalos user, /var/www/thalos dir
#   - systemd unit installed at /etc/systemd/system/thalos.service
#   - SSH key auth set up

set -eu

SERVER=""          # e.g. thalos.at or 1.2.3.4
SSH_USER="root"    # who can restart systemd
APP_USER="www-thalos"
APP_DIR="/var/www/thalos"

[ -z "$SERVER" ] && { echo "Set SERVER in this script first."; exit 1; }

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "→ building Node bundle"
npm run build:node

echo "→ rsync dist/ → $APP_USER@$SERVER:$APP_DIR/"
rsync -avz --delete -e ssh dist/ "$APP_USER@$SERVER:$APP_DIR/"

echo "→ restarting service"
ssh "$SSH_USER@$SERVER" "systemctl restart thalos"

echo "→ health check"
sleep 2
ssh "$SSH_USER@$SERVER" "systemctl is-active thalos"

echo "✓ deployed"
